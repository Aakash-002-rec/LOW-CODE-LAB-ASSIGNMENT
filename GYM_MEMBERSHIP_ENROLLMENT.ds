 application "GYM MEMBERSHIP ENROLLMENT"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Membership_Enrollment_Form
		{
			success message = "Data Added Successfully!"
			Section2
			(
				type = section
				displayname = " Member Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Member_Name1
			(
    			type = name
				displayname = "Member_Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Age
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Membership_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Details
			(
				type = section
				displayname = "Contact Details "
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Email_Address1
			(
    			type = email
				displayname = "Email_Address"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Residential_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Membership_Fitness_Preferences
			(
				type = section
				displayname = "Membership & Fitness Preferences"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Membership_Plan
			(
				type = picklist
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Emergency_Contact_Name
			(
    			type = text
	 			row = 3
	 			column = 1   
				width = medium
			)
			Preferred_Activities
			(
				type = list	
				values = {"Choice 1","Choice 2","Choice 3"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Fitness_Goals_Medical_Notes
			(
    			type = textarea
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section4
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Preferred_Start_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Membership_End_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Preferred_Workout_Slot
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Health_Declaration_Waiver
			(
				type = checkboxes	
				values = {"Choice 1","I declare my fitness to exercise and accept the liability waiver","Choice 2","Choice 3"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Fee_Trainer_Preference
			(
				type = section
				displayname = "Fee & Trainer Preference"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			must have Requires_Personal_Trainer
			(
    			type = checkbox
				initial value = false
	 			row = 5
	 			column = 1   
				width = medium
			)
			Membership_Fee_Paid
			(
				type = INR
				format = commadotindian
	 			row = 5
	 			column = 1   
				width = medium
			)
			Referral_Discount_Percent
			(
    			type = percentage
	 			row = 5
	 			column = 1   
				width = medium
			)
			Total_Amount_Payable
			(
				type = decimal
				displayname = "Total Amount Payable"
	 			row = 5
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Membership_Fee_Paid - input.Membership_Fee_Paid * input.Referral_Discount_Percent
    						visibility = false
    			)
			)
			Fitness_Assessment_Trainer_Assignment
			(
				type = section
				displayname = "Fitness Assessment & Trainer Assignment"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Assigned_Trainer_Lookup
			(
				type = picklist	
				values  = Trainers.ID
    			displayformat = [Trainer_Name + " - " + Trainer_Name]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Member_Photo
			(
    			type = image
				source  = file
    			file count = 2
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 6
	 			column = 1   
				width = medium
			)
			Medical_Certificate_Upload
			(
    			type = upload file
    			file count = 5
				browse = local_drive
	 			row = 6
	 			column = 1   
				width = medium
			)
			Current_BMI
			(
				type = decimal
	 			row = 6
	 			column = 1   
				width = medium
			)
			Family_Members_Enrolled
			(
				type = grid
				maxrow = 5
				Family_Member_Name
				(
    				type = text
					displayname = "Family Member Name"
					width = medium
				)
				age
				(
					type = number
					width = medium
				)
				Relationship
				(
    				type = text
					width = medium
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			Family_Media_Details
			(
				type = section
				displayname = "Family & Media Details"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Fitness_Social_Profile_URL
			(
    			type = url
				enable  linkname
	 			row = 8
	 			column = 1   
				width = medium
			)
			Fitness_Goal_Video_Intro
			(
    			type = video
    			duration=30
	 			row = 8
	 			column = 1   
				width = medium
			)
			Health_Concern_Voice_Note
			(
     			type = audio
    			duration=60
	 			row = 8
	 			column = 1   
				width = medium
			)
			Declaration_System_Generated_Values
			(
				type = section
				displayname = " Declaration & System-Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Gym_Rules_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
    			description
    			[
    				type = tooltip
    			 	message = "1. Carry your membership ID while entering the gym.\n2. Follow trainer instructions and gym safety guidelines.\n3. Proper gym attire is required.\n4. Return equipment after use.\n5. Maintain cleanliness in the gym."
    			]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Member_Digital_Signature
			(
    			type = signature
	 			row = 9
	 			column = 1   
				width = medium
				personal data = true
			)
			Enrollment_Submitted_On
			(
    			type = datetime
				displayname = "Enrollment_Submitted_On "
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			Membership_ID
			(
    			type = autonumber
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "${Membership_ID}"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Status
			(
				type = section
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Active
			(
				type = picklist
				displayname = "status"
				maxchar = 100
				values = {"Choice 1","Enquiry","Choice 2","Enrolled","Choice 3","Active","Expired"}
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Enquiry","Payment","Active","Document Verification","Expired"}
			}
		}
		form Trainers
		{
			success message = "Trainer Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Trainer
			(
				type = section
				displayname = "MEMBERS_ENROLLMENT_FORM"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
