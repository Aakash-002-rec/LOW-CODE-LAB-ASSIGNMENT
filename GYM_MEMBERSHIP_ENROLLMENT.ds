		workflow
		{
		form
		{
			Age as "Age"
			{
				type =  form
				form = Membership_Enrollment_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Age < 14 || Age > 75)
										{
											alert "Age must be between 14 and 75.";
											cancel submit;
										}
						)
					}
				}

			}
			Validate_Start_Date as "Validate_Start_Date"
			{
				type =  form
				form = Membership_Enrollment_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Preferred_Start_Date < zoho.currentdate)
										{
											alert "Preferred Start Date cannot be in the past.";
											cancel submit;
										}
						)
					}
				}

			}
			On_Enrollment_Submit_Work as "On_Enrollment_Submit_Workflow"
			{
				type =  form
				form = Membership_Enrollment_Form

				record event = on add or edit

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "aakashraja2502@gmail.com"
							subject : "Warm Welcome to Gym"
							message : "<pre dir=\"ltr\"><code>Welcome to our gym!\n\nYour membership has been successfully registered.\n\nMembership ID: <code>${Membership_ID}</code>\nMembership Type: ${Membership_Type}\nStart Date: ${Preferred_Start_Date}\nEnd Date: ${Membership_End_Date}\n\nPlease visit the front desk for your gym orientation.\n\nThank you,\nGym Membership Team</code><br></pre><div><br></div>"
						)
					}
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address1
							subject : "Welcome to Our Gym - Membership Confirmed"
							message : "<pre dir=\"ltr\"><code>Welcome to our Gym!\n\nYour membership has been successfully registered.\n\nMembership ID: [Membership ID]\nMembership Type: [Membership Type]\nStart Date: [Membership Start Date]\nEnd Date: [Membership End Date]\n\nPlease visit the gym front desk for your orientation.\n\nThank you,\nGym Membership Team</code><br></pre><div><br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Renewal_Reminder_Sc as "Daily_Renewal_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 16:39:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						members = Membership_Enrollment_Form[Membership_End_Date >= zoho.currentdate && Membership_End_Date <= zoho.currentdate.addDay(7)];
										for each  member in members
										{
											if(member.Membership_Type != "Renewal")
											{
												sendmail
												[
													from :zoho.adminuserid
													to :member.Email_Address1
													subject :"Gym Membership Renewal Reminder"
													message :"Dear " + member.Member_Name1 + ",<br><br>" + "Your gym membership is expiring soon.<br><br>" + "Membership ID: " + member.Membership_ID + "<br>" + "Expiry Date: " + member.Membership_End_Date + "<br><br>" + "Please renew your membership to continue enjoying our services.<br><br>" + "Thank you,<br>" + "Gym Membership Team"
												]
											}
										}
					)
					}
				}
			}
		}

		approval
		{
			Corporate_Bulk_Enrollment as "Corporate_Bulk_Enrollment_Approval"
			{
				type =  approval
				form = Membership_Enrollment_Form[Membership_Type == "corporate"]
				display fields = [Member_Name1,Age,Membership_Type,Email_Address1,Contact_Number,Residential_Address,Membership_Plan]
				on start
				{
				}
			}
		}

		blueprint
		{
    			Membership_Lifecycle_Blueprint as "Membership Lifecycle Blueprint"
    			{
        			type = Blueprint
        			form = Membership_Enrollment_Form
        			start
        			{
            			start stage = "Enquiry"
        			}
        			stages
        			{
           			"Enquiry"
           			{
           			}
           			"Payment"
           			{
           			}
           			"Active"
           			{
           			}
           			"Document Verification"
           			{
           			}
           			"Expired"
           			{
           			}
        			}
        			transitions
        			{
    				active_to_expired as "Mark as Expired"
    				{
         				type = normal
         				from stage = "Active"
         				to stage = "Expired"
         				before
         				{
            				transition owner
            				(
                				userfields = {Added_User}
             				)
            				confirmation before execution
            				(
                				message = "Confirm membership has expired?"
                				confirm button text = "Expire"
                				cancel button text = "Cancel"
            				)
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															// Set the Active field to "Expired" option
														input.Active = "Expired";
								)
							}
         				}
  				}
    				document_verification_to_payment as "Verify Documents"
    				{
         				type = normal
         				from stage = "Document Verification"
         				to stage = "Payment"
         				before
         				{
            				transition owner
            				(
                				userfields = {Added_User}
             				)
            				confirmation before execution
            				(
                				message = "Confirm document verification complete?"
                				confirm button text = "Proceed"
                				cancel button text = "Cancel"
            				)
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															// Set the Active field to "Payment" option
														input.Active = "Payment";
								)
							}
         				}
  				}
    				enquiry_to_document_verification as "Verify Enrollment"
    				{
         				type = normal
         				from stage = "Enquiry"
         				to stage = "Document Verification"
         				before
         				{
            				transition owner
            				(
                				userfields = {Added_User}
             				)
            				confirmation before execution
            				(
                				message = "Confirm document verification?"
                				confirm button text = "Verify"
                				cancel button text = "Cancel"
            				)
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															// Set the Active field to 'Enrolled' based on the available options
														input.Active = "Enrolled";
								)
							}
         				}
  				}
    				payment_to_active as "Activate Membership"
    				{
         				type = normal
         				from stage = "Payment"
         				to stage = "Active"
         				before
         				{
            				transition owner
            				(
                				userfields = {Added_User}
             				)
            				confirmation before execution
            				(
                				message = "Confirm payment received and activate membership?"
                				confirm button text = "Activate"
                				cancel button text = "Cancel"
            				)
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															// Set the Active field to "Active" based on the current selection
														if(input.Active == "Active")
														{
															input.Active = "Active";
														}
														else
														{
															input.Active = "Active";
														}
								)
							}
         				}
  				}
        			}
    			}
		}


	}
